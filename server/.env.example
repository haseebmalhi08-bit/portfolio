# ──────────────────────────────────────────────
#  PORTFOLIO BACKEND — Environment Variables
#  Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# MongoDB connection string (from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT secret key — use a long random string
JWT_SECRET=your_super_secret_jwt_key_here

# Admin password — used to log in to the admin panel
ADMIN_PASSWORD=your_admin_password_here

# Server port (default: 5000)
PORT=5000

# Frontend URL for CORS (leave blank to use defaults)
FRONTEND_URL=

# ──────────────────────────────────────────────
#  Email Configuration (for contact form)
#  Use a Gmail App Password (not your real password)
#  Guide: https://support.google.com/accounts/answer/185833
# ──────────────────────────────────────────────
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
